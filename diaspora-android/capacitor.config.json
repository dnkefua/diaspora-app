{
  "appId": "com.ndnanalyticsinc.thediaspora",
  "appName": "The Diaspora App",
  "webDir": "www",
  "server": {
    "url": "https://www.thediaspora.app",
    "cleartext": false
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["google.com"]
    }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}

{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "package.json",
      "package-lock.json",
      "npm-debug.log",
      "yarn.lock",
      "pnpm-lock.yaml",
      "tsconfig.json",
      "README.md",
      "*.md",
      "*.yml",
      "*.yaml",
      "**/.*",
      ".git",
      ".git/**",
      ".github",
      ".github/**",
      ".claude",
      ".claude/**",
      ".expo",
      ".expo/**",
      ".firebase",
      "**/node_modules/**",
      "diaspora-mobile/**",
      "dataconnect/**",
      "dataconnect-generated/**",
      "dev-server.js",
      "firestore.rules",
      "storage.rules",
      "FIREBASE_SETUP.md",
      "firebase-debug.log",
      "*.log"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|svg|png|jpg|jpeg|webp|avif|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "robots.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "sitemap.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "dataconnect": {
    "source": "dataconnect"
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── admins/{uid} ─────────────────────────────────────
    // Source of truth for admin role.
    // Bootstrap: create the first doc manually in Firebase Console
    // (Firestore → admins → add document, doc ID = the user's UID).
    // No client write path — admins are managed via Console / gcloud.
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ── users/{uid} ──────────────────────────────────────
    // Auth'd users can read directory of users; only owner writes own profile.
    // Admin can edit any user (e.g. to flag/disable).
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Subcollection: saved/{businessId} — user's saved businesses
      match /saved/{businessId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ── businesses/{bizId} ───────────────────────────────
    // Public read. Owner creates and edits content fields.
    // Trust signals (verified, premium, featured) are admin-only.
    match /businesses/{bizId} {
      allow read: if true;

      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        // Owner cannot self-mark trust signals at creation
        && (!('verified' in request.resource.data) || request.resource.data.verified == false)
        && (!('featured' in request.resource.data) || request.resource.data.featured == false)
        && (!('premium' in request.resource.data) || request.resource.data.premium == false)
      );

      allow update: if (
          // Owner can update their listing, but cannot change protected fields
          isOwner(resource.data.ownerId)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'verified', 'featured', 'premium',
                'verifiedAt', 'featuredAt', 'premiumAt',
                'verificationReport',
                'ownerId'
              ])
        ) || (
          // Admin can change anything
          isAdmin()
        );

      allow delete: if isAdmin() || isOwner(resource.data.ownerId);
    }

    // ── reviews/{id} ─────────────────────────────────────
    // Public read. Authenticated create with validation.
    // Author or admin can edit/delete.
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.businessId is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && (!('text' in request.resource.data) || (
              request.resource.data.text is string
              && request.resource.data.text.size() <= 1500
           ));

      allow update: if (
          isOwner(resource.data.authorUid)
          // Author cannot change businessId or authorUid via update
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['businessId', 'authorUid'])
        ) || isAdmin();

      allow delete: if isOwner(resource.data.authorUid) || isAdmin();
    }

    // ── orders/{id} ──────────────────────────────────────
    // Customer order intent. The actual transaction happens in WhatsApp;
    // these docs let sellers see orders that came via the app and let
    // customers see their own order history.
    //
    // Required schema (validated on create):
    //   businessId         string
    //   businessOwnerId    string  — denormalized so owner reads work without get()
    //   customerUid        string  == request.auth.uid
    //   items              list    — [{name, qty, price?, notes?}]
    //   status             string  in ['pending','sent','cancelled','fulfilled']
    //   createdAt          timestamp
    //
    // Optional fields: customerName, customerPhone, customerNote,
    // mode ('inquiry'|'pickup'|'delivery'), total, currency,
    // whatsappMessage, sentAt.
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.customerUid == request.auth.uid)
        || (isSignedIn() && resource.data.businessOwnerId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.businessId is string
        && request.resource.data.businessOwnerId is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.status in ['pending', 'sent']
        && (!('customerNote' in request.resource.data) ||
            (request.resource.data.customerNote is string
             && request.resource.data.customerNote.size() <= 500));

      // Customer can update only their own status (e.g. 'cancelled'); admin and
      // business owner can update freely.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.businessOwnerId == request.auth.uid)
        || (
          isSignedIn()
          && resource.data.customerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'sentAt', 'updatedAt'])
        );

      allow delete: if isAdmin();
    }

    // ── verification_requests/{id} ───────────────────────
    // Sellers create a request; admin reads + processes.
    match /verification_requests/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.tier in ['verified', 'premium'];
      allow read: if isAdmin() || (isSignedIn()
        && resource.data.requesterUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── event_submissions/{id} ───────────────────────────
    // Authenticated users create; admin moderates.
    match /event_submissions/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── moderation_log/{id} ──────────────────────────────
    // Append-only audit log for admin actions. Admin reads, no client writes
    // (server / Cloud Functions write these).
    match /moderation_log/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── sponsorships/{id} ────────────────────────────────
    // Source of truth for paid placements that override the landing-page
    // hardcoded slides/tiles. Public read (landing page reads on each load).
    // Admin-only write — until payment flow lands, admin manually creates
    // sponsorships from the moderation console.
    match /sponsorships/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── content_reports/{id} ─────────────────────────────
    // User reports/flags of user-generated content (reviews). Any signed-in
    // user can file a report about someone else's content; admin reads/actions.
    // Satisfies Google Play's UGC report/moderation requirement.
    match /content_reports/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.targetId is string
        && (!('reason' in request.resource.data) ||
            (request.resource.data.reason is string && request.resource.data.reason.size() <= 60))
        && (!('note' in request.resource.data) ||
            (request.resource.data.note is string && request.resource.data.note.size() <= 500));
      allow read, update, delete: if isAdmin();
    }

    // ── Default deny ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
